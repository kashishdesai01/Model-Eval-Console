  "components": {
    "schemas": {
      "CandidateCreate": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "pattern": "^[\\w .-]+$",
            "title": "Name"
          },
          "hf_model_id": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "pattern": "^[\\w.-]+(/[\\w.-]+)?$",
            "title": "Hf Model Id"
          },
          "hf_revision": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$",
            "title": "Hf Revision"
          },
          "serving_config": {
            "$ref": "#/components/schemas/ServingConfig"
          }
        },
        "type": "object",
        "required": [
          "name",
          "hf_model_id",
          "hf_revision"
        ],
        "title": "CandidateCreate"
      },
      "CandidateOut": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "pattern": "^[\\w .-]+$",
            "title": "Name"
          },
          "hf_model_id": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "pattern": "^[\\w.-]+(/[\\w.-]+)?$",
            "title": "Hf Model Id"
          },
          "hf_revision": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$",
            "title": "Hf Revision"
          },
          "serving_config": {
            "$ref": "#/components/schemas/ServingConfig"
          },
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          }
        },
        "type": "object",
        "required": [
          "name",
          "hf_model_id",
          "hf_revision",
          "serving_config",
          "id",
          "created_at"
        ],
        "title": "CandidateOut"
      },
      "ComparisonCreate": {
        "properties": {
          "baseline_run_id": {
            "type": "string",
            "format": "uuid",
            "title": "Baseline Run Id"
          },
          "candidate_run_id": {
            "type": "string",
            "format": "uuid",
            "title": "Candidate Run Id"
          },
          "metric": {
            "type": "string",
            "const": "accuracy",
            "title": "Metric",
            "default": "accuracy"
          },
          "margin": {
            "type": "number",
            "maximum": 1.0,
            "exclusiveMinimum": 0.0,
            "title": "Margin",
            "default": 0.01
          },
          "n_resamples": {
            "type": "integer",
            "maximum": 50000.0,
            "minimum": 100.0,
            "title": "N Resamples",
            "default": 10000
          },
          "seed": {
            "type": "integer",
            "maximum": 2147483647.0,
            "minimum": 0.0,
            "title": "Seed",
            "default": 42
          }
        },
        "type": "object",
        "required": [
          "baseline_run_id",
          "candidate_run_id"
        ],
        "title": "ComparisonCreate"
      },
      "ComparisonOut": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "metric": {
            "type": "string",
            "title": "Metric"
          },
          "baseline": {
            "$ref": "#/components/schemas/ScoreRef"
          },
          "candidate": {
            "$ref": "#/components/schemas/ScoreRef"
          },
          "margin": {
            "type": "number",
            "title": "Margin"
          },
          "delta": {
            "type": "number",
            "title": "Delta"
          },
          "ci95": {
            "prefixItems": [
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ],
            "type": "array",
            "maxItems": 2,
            "minItems": 2,
            "title": "Ci95"
          },
          "verdict": {
            "type": "string",
            "enum": [
              "pass",
              "fail",
              "inconclusive"
            ],
            "title": "Verdict"
          },
          "mcnemar_p": {
            "type": "number",
            "title": "Mcnemar P"
          },
          "regressions": {
            "type": "integer",
            "title": "Regressions"
          },
          "fixes": {
            "type": "integer",
            "title": "Fixes"
          },
          "standard_error": {
            "type": "number",
            "title": "Standard Error"
          },
          "warnings": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Warnings"
          },
          "slices": {
            "items": {
              "$ref": "#/components/schemas/SliceResult"
            },
            "type": "array",
            "title": "Slices"
          },
          "flips": {
            "items": {
              "$ref": "#/components/schemas/Flip"
            },
            "type": "array",
            "title": "Flips"
          },
          "near_boundary_share": {
            "type": "number",
            "title": "Near Boundary Share"
          },
          "n_examples": {
            "type": "integer",
            "title": "N Examples"
          },
          "seed": {
            "type": "integer",
            "title": "Seed"
          },
          "n_resamples": {
            "type": "integer",
            "title": "N Resamples"
          },
          "latency_budget_pass": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Latency Budget Pass"
          },
          "latency_ratio": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Latency Ratio"
          },
          "evidence": {
            "type": "string",
            "enum": [
              "measured",
              "fixture"
            ],
            "title": "Evidence"
          }
        },
        "type": "object",
        "required": [
          "id",
          "metric",
          "baseline",
          "candidate",
          "margin",
          "delta",
          "ci95",
          "verdict",
          "mcnemar_p",
          "regressions",
          "fixes",
          "standard_error",
          "warnings",
          "slices",
          "flips",
          "near_boundary_share",
          "n_examples",
          "seed",
          "n_resamples",
          "latency_budget_pass",
          "latency_ratio",
          "evidence"
        ],
        "title": "ComparisonOut"
      },
      "DatasetCreate": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Name",
            "default": "SST-2 validation"
          },
          "hf_dataset": {
            "type": "string",
            "enum": [
              "stanfordnlp/sst2",
              "stanfordnlp/imdb"
            ],
            "title": "Hf Dataset",
            "default": "stanfordnlp/sst2"
          },
          "hf_config": {
            "type": "string",
            "enum": [
              "default",
              "plain_text"
            ],
            "title": "Hf Config",
            "default": "default"
          },
          "split": {
            "type": "string",
            "enum": [
              "validation",
              "test"
            ],
            "title": "Split",
            "default": "validation"
          },
          "hf_revision": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$",
            "title": "Hf Revision"
          }
        },
        "type": "object",
        "required": [
          "hf_revision"
        ],
        "title": "DatasetCreate"
      },
      "DatasetOut": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "hf_dataset": {
            "type": "string",
            "title": "Hf Dataset"
          },
          "hf_config": {
            "type": "string",
            "title": "Hf Config"
          },
          "split": {
            "type": "string",
            "title": "Split"
          },
          "hf_revision": {
            "type": "string",
            "title": "Hf Revision"
          },
          "content_hash": {
            "type": "string",
            "title": "Content Hash"
          },
          "n_examples": {
            "type": "integer",
            "title": "N Examples"
          },
          "provenance": {
            "additionalProperties": true,
            "type": "object",
            "title": "Provenance"
          }
        },
        "type": "object",
        "required": [
          "id",
          "name",
          "hf_dataset",
          "hf_config",
          "split",
          "hf_revision",
          "content_hash",
          "n_examples"
        ],
        "title": "DatasetOut"
      },
      "Flip": {
        "properties": {
          "idx": {
            "type": "integer",
            "title": "Idx"
          },
          "text": {
            "type": "string",
            "title": "Text"
          },
          "label": {
            "type": "integer",
            "title": "Label"
          },
          "baseline_prob": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Baseline Prob"
          },
          "candidate_prob": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Candidate Prob"
          },
          "baseline_output": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Baseline Output"
          },
          "candidate_output": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Candidate Output"
          },
          "baseline_pred": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Baseline Pred"
          },
          "candidate_pred": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Candidate Pred"
          },
          "slices": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Slices"
          },
          "near_boundary": {
            "type": "boolean",
            "title": "Near Boundary"
          },
          "kind": {
